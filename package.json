{
  "name": "yemen-chat-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,database",
    "deploy": "firebase deploy --only functions",
    "test": "npm run build && node --test lib/lib/common.test.js",
    "test:rules": "npm run build && firebase emulators:exec --project demo-yemenchat --only firestore,database \"node --test test/rules.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "googleapis": "^140.0.1",
    "livekit-server-sdk": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.0"
  }
}