rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage() && request.resource.size < 5 * 1024 * 1024;
    }
    match /room_covers/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage() && request.resource.size < 5 * 1024 * 1024;
    }
    match /chat_images/{chatId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*') && isImage() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
